# Kilnmark's settings for compose.yaml. Copy this file to .env beside compose.yaml, fill in every
# required value, and keep .env readable only by the people who run Kilnmark:
#   cp .env.example .env && chmod 600 .env
# compose.yaml has no default password or token: it refuses to start while a required value is
# missing or empty, and names it.

# Required. Password of Kilnmark's database; the kilnmark user owns it and is its PostgreSQL
# superuser. Use a long random value, for example the output of: openssl rand -base64 32
# It takes effect when the database volume is first created; changing it later also needs
# ALTER USER kilnmark PASSWORD '...' in the database.
KILNMARK_DB_PASSWORD=

# Required. Kilnmark's admin API token: km_ followed by 43 or more letters, digits, - or _.
# Make one with: echo km_$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=')
# Sign in with it, then create personal tokens under API tokens. Changing it sets the old one aside.
KILNMARK_ADMIN_TOKEN=

# Optional. The ports Kilnmark and its database are published on (the database on this machine only).
# KILNMARK_PORT=8780
# KILNMARK_DB_PORT=5442

# Optional. Sign-in with your organisation's identity provider over OpenID Connect (Entra ID, Okta,
# Ping, ADFS, Keycloak, ...), beside API tokens; INSTALL.md, "Sign in with your identity provider".
# Register Kilnmark with the provider as a web application whose redirect URI is
# https://<kilnmark's address>/api/v1/auth/login, then set:
# KILNMARK_OIDC_ENABLED=true
# KILNMARK_OIDC_ISSUER=https://login.example.com/your-tenant/v2.0
# KILNMARK_OIDC_CLIENT_ID=
# KILNMARK_OIDC_CLIENT_SECRET=
# KILNMARK_OIDC_PROVIDER_NAME=Example SSO
# Groups (as the provider's groups claim names them, comma-separated) and the role each gives:
# KILNMARK_OIDC_VIEWER_GROUPS=
# KILNMARK_OIDC_STEWARD_GROUPS=
# KILNMARK_OIDC_DESIGNER_GROUPS=
# KILNMARK_OIDC_ADMIN_GROUPS=
# Designers in these groups see values of columns marked sensitive:
# KILNMARK_OIDC_UNMASK_GROUPS=

# Optional. Host names bulk import rewrites when asked to (remapHosts=true), as from=to pairs.
# KILNMARK_SOURCES_HOST_MAP=localhost=host.docker.internal

# Not set here: the key that encrypts stored source passwords is generated on first start in the
# keys volume (/var/lib/kilnmark/secret.key). Back that volume up apart from the database.
