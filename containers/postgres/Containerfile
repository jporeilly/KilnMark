# PostgreSQL 18 with Apache AGE (graph) and pgvector (embeddings).
# The official image already includes the PostgreSQL apt repository that ships both extensions.
# Image names are fully qualified so Podman never has to guess a registry.
# Pinned by digest, so every build starts from the same layers; Dependabot moves the digest.
FROM docker.io/library/postgres:18@sha256:bd5dfa494a5a259704365813dbfa5fa6b3e69be7348d43b547f540c730478583

RUN apt-get update \
 && apt-get install -y --no-install-recommends postgresql-18-age postgresql-18-pgvector \
 && rm -rf /var/lib/apt/lists/*

# AGE must be preloaded. Set in the configuration template, so it holds whatever command the
# container is started with (test tools often pass their own).
RUN sed -i "s/^#\?shared_preload_libraries = .*/shared_preload_libraries = 'age'/" \
      /usr/share/postgresql/postgresql.conf.sample \
 && grep -q "^shared_preload_libraries = 'age'" /usr/share/postgresql/postgresql.conf.sample

# TLS on (ADR 0032): a certificate made on first start in the data volume, then the image's own
# entrypoint with the TLS settings added. The command stays the image's, so tools that pass their
# own still work.
COPY kilnmark-tls.sh /usr/local/bin/kilnmark-tls.sh
# The Starter Pack's database (ADR 0051): the samples-db service of compose.yaml runs this one-off
# at every start, to make or keep the empty database kilnmark_samples and its own login.
COPY kilnmark-samples-db.sh /usr/local/bin/kilnmark-samples-db.sh
# and its login reaches that database only (pg_hba.conf), from a new data folder's first start on.
COPY kilnmark-hba.sh /usr/local/bin/kilnmark-hba.sh
COPY kilnmark-hba-initdb.sh /docker-entrypoint-initdb.d/kilnmark-hba.sh
RUN chmod 755 /usr/local/bin/kilnmark-tls.sh /usr/local/bin/kilnmark-samples-db.sh /usr/local/bin/kilnmark-hba.sh \
      /docker-entrypoint-initdb.d/kilnmark-hba.sh
ENTRYPOINT ["kilnmark-tls.sh"]
CMD ["postgres"]
