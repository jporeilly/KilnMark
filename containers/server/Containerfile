# The Kilnmark server image: one image, roles chosen with KILNMARK_ROLES.
# Build the app first: ./gradlew :server:quarkusBuild  (output in dist/build/server/quarkus-app)
# Runs as a non-root user, so it works rootless under Podman.
# APP_DIR is the built server inside the build context: the repository's build output by default,
# and server in a release folder (its compose.yaml passes it).
FROM docker.io/library/eclipse-temurin:25-jre
ARG APP_DIR=dist/build/server/quarkus-app

RUN useradd --system --uid 1001 kilnmark \
 && mkdir -p /var/lib/kilnmark && chown 1001:1001 /var/lib/kilnmark
WORKDIR /opt/kilnmark
COPY --chown=1001:1001 ${APP_DIR}/ ./

USER 1001
EXPOSE 8780
# KILNMARK_IN_CONTAINER: localhost is this container, and host.containers.internal and
# host.docker.internal (the machine running it) count as local model hosts by default.
ENV KILNMARK_ROLES=api,scheduler,worker \
    KILNMARK_SECRET_KEY_FILE=/var/lib/kilnmark/secret.key \
    KILNMARK_IN_CONTAINER=true
# The key that encrypts stored source passwords; keep this volume, and back it up apart from the database.
VOLUME /var/lib/kilnmark
ENTRYPOINT ["java", "-XX:+UseZGC", "-jar", "quarkus-run.jar"]
