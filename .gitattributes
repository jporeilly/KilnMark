# Normalise line endings; scripts that run in Linux containers must stay LF.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.jar binary
*.png binary
# Lab and test documents are kept byte for byte (mail uses CRLF line ends)
*.eml binary
*.msg binary
*.doc binary
# The local CI runner's entrypoint runs in Linux.
ci/local-runner/*.sh text eol=lf
